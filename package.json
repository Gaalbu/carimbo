{
  "name": "carimbo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Checagens de fatos publicadas por agências brasileiras, carimbadas numa tela só.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/sources",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build:packages": "npm run build -w @carimbo/core -w @carimbo/sources",
    "lint": "npm run build:packages && eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
